<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS8619;CS8620;CS8625;xUnit1012;xUnit2004</NoWarn>
  </PropertyGroup>

  <!-- Основной проект ищется рядом: ..\Project001 или ..\Project001-main.
       Либо: dotnet test -p:Project001Csproj=путь\Project001.csproj -->
  <PropertyGroup Condition="'$(Project001Csproj)' == ''">
    <Project001Csproj Condition="Exists('$(MSBuildThisFileDirectory)..\Project001\Project001.csproj')">$(MSBuildThisFileDirectory)..\Project001\Project001.csproj</Project001Csproj>
    <Project001Csproj Condition="'$(Project001Csproj)' == '' And Exists('$(MSBuildThisFileDirectory)..\Project001-main\Project001.csproj')">$(MSBuildThisFileDirectory)..\Project001-main\Project001.csproj</Project001Csproj>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Project001Csproj)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net" />
    <Using Include="Xunit" />
    <Using Include="Moq" />
    <Using Include="Project001" />
    <Using Include="Project001.IntegrationTests.Infrastructure" />
  </ItemGroup>

  <Target Name="CheckProject001" BeforeTargets="ResolveProjectReferences;CollectPackageReferences" Condition="'$(Project001Csproj)' == ''">
    <Error Text="Не найден Project001.csproj. Положите репозиторий Project001 рядом с этой папкой (..\Project001) или укажите -p:Project001Csproj=..." />
  </Target>

</Project>
